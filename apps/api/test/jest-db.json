{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".db-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/db/support/setup-env.ts"],
  "globalTeardown": "<rootDir>/db/support/global-teardown.ts",
  "testTimeout": 30000,
  "forceExit": true,
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1",
    "^@core/(.*)$": "<rootDir>/../src/core/$1",
    "^@utils/(.*)$": "<rootDir>/../src/utils/$1"
  }
}
