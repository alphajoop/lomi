# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
# Set by Railway automatically in production (default local: 3000)
# PORT=3000

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Redis / BullMQ (required in production)
# Async webhooks, usage metering, and billing queues. Without UPSTASH_REDIS_URL,
# the API falls back to synchronous processing where possible.
# ---------------------------------------------------------------------------
# UPSTASH_REDIS_URL=rediss://default:YOUR_TOKEN@your-db.upstash.io:6379

# Local dev only (when UPSTASH_REDIS_URL is unset)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://lomi.africa,https://dashboard.lomi.africa,https://api.lomi.africa,https://portal.lomi.africa,https://pay.lomi.africa,https://store.lomi.africa,https://checkout.lomi.africa


# ---------------------------------------------------------------------------
# Stripe (required for card payments)
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_SECRET_KEY_TEST=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_WEBHOOK_SECRET_TEST=whsec_...

# ---------------------------------------------------------------------------
# Wave (required for Wave webhooks)
# ---------------------------------------------------------------------------
# WAVE_WEBHOOK_SECRET=your-wave-webhook-secret

# ---------------------------------------------------------------------------
# SPI / PI-SPI (platform participant — OAuth2 + mTLS)
# Required in production. Sandbox defaults apply only when NODE_ENV != production.
# PEM values: inline PEM, base64-encoded PEM, or path to a PEM file.
# ---------------------------------------------------------------------------
# SPI_BASE_URL=https://api.pi-bceao.com/piz/v1
# SPI_TOKEN_URL=https://api.pi-bceao.com/oauth/token
# SPI_CLIENT_ID=your-participant-client-id
# SPI_CLIENT_SECRET=your-participant-client-secret
# SPI_CLIENT_CERT=-----BEGIN CERTIFICATE-----...
# SPI_CLIENT_KEY=-----BEGIN PRIVATE KEY-----...
# SPI_CA_CERT=-----BEGIN CERTIFICATE-----...
# SPI_WEBHOOK_SECRET=shared-hmac-secret-with-bceao

# ---------------------------------------------------------------------------
# GIM Pay / PaySky (direct PayByCard — Mode Direct)
# Required in production. UAT default applies when NODE_ENV != production.
# ---------------------------------------------------------------------------
# GIM_BASE_URL=https://omni-uat.gimpay.org/Cube/PayLink.svc/api/PayByCard
# GIM_MERCHANT_ID=your-merchant-id
# GIM_TERMINAL_ID=your-terminal-id
# GIM_SECRET_KEY_HEX=hex-encoded-merchant-secret-key
# GIM_RETURN_URL=https://api.lomi.africa/payments/gim/return
# GIM_AMOUNT_MULTIPLIER=100
# GIM_DISABLE_3DS=false
# GIM_DATETIME_LOCAL_TRXN_DIGITS=12

# MTN: callbacks are verified via Collection API status re-check (X-Reference-Id).
# MTN_WEBHOOK_SECRET is optional for local/staging only (not used in production).
# MTN_WEBHOOK_SECRET=your-mtn-webhook-shared-secret
# MTN: callbacks are verified via Collection API status re-check (X-Reference-Id).
# MTN_WEBHOOK_SECRET is optional for local/staging only (not used in production).
# MTN_WEBHOOK_SECRET=your-mtn-webhook-shared-secret

# ---------------------------------------------------------------------------
# Feature flags (see api_runtime_config in Supabase for SQL flags)
# ---------------------------------------------------------------------------
# CLI_LISTEN_ALLOW_PRODUCTION=true
# RATE_LIMIT_POLICY_RESOLVER_ENABLED=false
