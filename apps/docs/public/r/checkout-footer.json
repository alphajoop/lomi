{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "checkout-footer",
  "type": "registry:block",
  "title": "Checkout Footer",
  "description": "Hosted checkout footer with lomi branding and legal links.",
  "files": [
    {
      "path": "components/lomi-ui/checkout-footer.tsx",
      "target": "components/lomi-ui/checkout-footer.tsx",
      "type": "registry:component",
      "content": "/* eslint-disable @next/next/no-img-element -- lomi. UI registry components are framework-portable copy-paste components. */\n\nimport * as React from 'react';\n\nexport interface CheckoutFooterProps {\n  termsHref?: string;\n  privacyHref?: string;\n  logoSrc?: string;\n  logoAlt?: string;\n  className?: string;\n}\n\nfunction cn(...classes: Array<string | false | null | undefined>) {\n  return classes.filter(Boolean).join(' ');\n}\n\nexport function CheckoutFooter({\n  termsHref = 'https://lomi.africa/terms?from=checkout',\n  privacyHref = 'https://lomi.africa/privacy?from=checkout',\n  logoSrc = '/company/lomi_l.webp',\n  logoAlt = 'lomi.',\n  className,\n}: CheckoutFooterProps) {\n  return (\n    <div className={cn('select-none', className)}>\n      <div className=\"flex flex-col items-center text-xs text-muted-foreground\">\n        <div className=\"mb-2 inline-flex items-center\">\n          <a\n            href=\"https://lomi.africa\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"flex items-baseline font-semibold transition-opacity hover:opacity-80\"\n          >\n            <img\n              src={logoSrc}\n              alt={logoAlt}\n              width={28}\n              height={28}\n              className=\"h-[28px] w-auto\"\n            />\n          </a>\n        </div>\n        <div className=\"flex items-center gap-2\">\n          <a\n            href={termsHref}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"font-medium text-muted-foreground transition-colors hover:text-primary\"\n          >\n            Terms\n          </a>\n          <span className=\"text-muted-foreground\">|</span>\n          <a\n            href={privacyHref}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"font-medium text-muted-foreground transition-colors hover:text-primary\"\n          >\n            Privacy\n          </a>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    },
    {
      "path": "components/lomi-ui/demo/checkout-footer-demo.tsx",
      "target": "components/lomi-ui/demo/checkout-footer-demo.tsx",
      "type": "registry:component",
      "content": "import { CheckoutFooter } from '@/components/lomi-ui/checkout-footer';\n\nexport function CheckoutFooterDemo() {\n  return (\n    <div className=\"not-prose flex justify-center rounded-sm border bg-background p-6 dark\">\n      <CheckoutFooter />\n    </div>\n  );\n}\n"
    }
  ],
  "assetFiles": [
    {
      "path": "public/company/lomi_l.webp",
      "target": "public/company/lomi_l.webp",
      "type": "registry:file",
      "encoding": "base64",
      "content": ""
    }
  ]
}
