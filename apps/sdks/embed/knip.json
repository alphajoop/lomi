{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/index.ts", "src/**/*.test.ts", "vite.config.ts"],
  "project": ["src/**/*.ts", "vite.config.ts"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off"
  }
}
